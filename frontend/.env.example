# Stellar ağı: testnet (varsayılan) veya mainnet (yalnızca işlemsiz tanıtım).
VITE_STELLAR_NETWORK=testnet
# Boşsa seçilen ağın varsayılan RPC adresi kullanılır.
# Özel RPC verilirse uygulama ağ kimliğini doğrular.
VITE_STELLAR_RPC_URL=

# Kontrat deploy edildikten sonra doldurulur (contract ID, C ile başlar).
# Boş bırakılırsa arayüz "kontrat henüz yapılandırılmadı" durumunu gösterir.
VITE_ROTATING_POOL_CONTRACT_ID=

# Yeni havuzlarda kullanılan Stellar asset (varsayılan: Circle testnet USDC).
# Canlı site kendi anchor'ımızın TRYT test varlığıyla derlenir (GitHub repo Variables ile verilir,
# bkz. docs/DEPLOY_CI.md). Mevcut havuzlar kendi token'ını kontrattan okur, bu ayardan etkilenmez.
VITE_POOL_ASSET_CODE=USDC
VITE_POOL_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Oluşturma formunda hazır gelen Testnet demo satıcısı (yalnızca ödeme alır). Boşsa projenin hazır adresi kullanılır.
VITE_DEMO_SELLER=

# Anchor'ın home domain'i (SEP-1 stellar.toml burada yayınlanır). Boşsa SDF test anchor'ı kullanılır.
# Canlı site: anchor-stellerpool.arslanyusuf.com (kendi işlettiğimiz test anchor'ı, TRYT; gerçek TL değildir).
# Mainnet tanıtımında canlı anchor akışı kapalıdır, yalnızca simülasyon gösterilir (docs/mainnet-showcase.md).
VITE_ANCHOR_HOME_DOMAIN=
