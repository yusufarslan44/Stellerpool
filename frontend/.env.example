# Stellar network: testnet (default) or mainnet (transaction-free showcase only).
VITE_STELLAR_NETWORK=testnet
# If empty, the default RPC URL of the selected network is used.
# If a custom RPC is given, the app verifies the network identity.
VITE_STELLAR_RPC_URL=

# Filled in after the contract is deployed (contract ID, starts with C).
# If left empty, the interface shows the "contract not configured yet" state.
VITE_ROTATING_POOL_CONTRACT_ID=

# The Stellar asset used in new pools (default: Circle testnet USDC).
# The live site is built with our own anchor's TRYT test asset (provided through GitHub repo Variables,
# see docs/DEPLOY_CI.md). Existing pools read their own token from the contract and are not affected by this setting.
VITE_POOL_ASSET_CODE=USDC
VITE_POOL_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# The Testnet demo seller pre-filled in the creation form (it only receives payments). If empty, the project's ready-made address is used.
VITE_DEMO_SELLER=

# The anchor's home domain (its SEP-1 stellar.toml is published there). If empty, the SDF test anchor is used.
# Live site: anchor-stellerpool.arslanyusuf.com (our own test anchor, TRYT; not real TRY).
# In the Mainnet showcase the live anchor flow is disabled and only a simulation is shown (docs/mainnet-showcase.md).
VITE_ANCHOR_HOME_DOMAIN=
