# Stellar ağı: testnet (varsayılan) veya mainnet
VITE_STELLAR_NETWORK=testnet

# Kontrat deploy edildikten sonra doldurulur (contract ID, C ile başlar).
# Boş bırakılırsa arayüz "kontrat henüz yapılandırılmadı" durumunu gösterir.
VITE_ROTATING_POOL_CONTRACT_ID=

# Havuzda kullanılan Stellar asset (varsayılan: testnet USDC).
VITE_POOL_ASSET_CODE=USDC
VITE_POOL_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Anchor (workshop'ta netleşince doldurulur), örn. testanchor.stellar.org
VITE_ANCHOR_HOME_DOMAIN=
