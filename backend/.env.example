# Stellarpool anchor — Testnet only. There is no real bank integration.

PORT=3001
# The publicly visible https address of this server (stellar.toml and the SEP-24 endpoints use it).
# When developing locally, put a tunnel (cloudflared/ngrok) address here; SEP-10/24 require https.
PUBLIC_BASE_URL=https://example.ngrok-free.app

STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Written here after scripts/setup-issuer.ts is run (see backend/README.md).
ISSUER_SECRET=
DISTRIBUTION_SECRET=

# Code of the test asset that represents TRY. It is not real TRY; let the code make that clear.
ASSET_CODE=TRYT

# SEP-10 JWT signing key (known only to this server; generate a random, long string).
JWT_SECRET=change-me-to-a-long-random-string

# How many seconds a SEP-24 transaction takes to complete without waiting for "real TRY confirmation" (demo convenience).
# In a real anchor this step depends on a bank/payment-institution webhook.
AUTO_CONFIRM_SECONDS=0
