# Stellerpool anchor — Testnet only. Gerçek banka entegrasyonu yoktur.

PORT=3001
# Bu sunucunun dışarıdan görünen https adresi (stellar.toml ve SEP-24 uçları bunu kullanır).
# Yerelde geliştirirken bir tünel (cloudflared/ngrok) adresini buraya yazın; SEP-10/24 https ister.
PUBLIC_BASE_URL=https://example.ngrok-free.app

STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# scripts/setup-issuer.ts çalıştırıldıktan sonra buraya yazılır (bkz. backend/README.md).
ISSUER_SECRET=
DISTRIBUTION_SECRET=

# TRY'yi temsil eden test varlığının kodu. Gerçek TRY değildir; kod bunu belli etsin.
ASSET_CODE=TRYT

# SEP-10 JWT imzalama anahtarı (yalnızca bu sunucu bilir; rastgele, uzun bir dize üretin).
JWT_SECRET=change-me-to-a-long-random-string

# Bir SEP-24 işleminin "gerçek TRY teyidi" beklemeden kaç saniyede tamamlanacağı (demo kolaylığı).
# Gerçek bir anchor'da bu adım banka/ödeme kuruluşu webhook'una bağlıdır.
AUTO_CONFIRM_SECONDS=0
