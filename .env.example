# Stellar Testnet
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deploy sonrası doldurulur
ROTATING_POOL_CONTRACT_ID=
TOKEN_CONTRACT_ID=

# Anchor home domain (stellar.toml). Boşsa arayüz SDF test anchor'ını kullanır
# (testanchor.stellar.org): gerçek SEP-1/10/24 akışı, test varlığı, TRY DEĞİL.
ANCHOR_HOME_DOMAIN=

# Frontend (Vite)
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_ROTATING_POOL_CONTRACT_ID=
# Anchor (boşsa testanchor.stellar.org) ve arayüzün izin verdiği en büyük grup.
# Varsayılan 12 (yayındaki kontratın sınırı); kontrat 30'u destekleyince 30 yapın.
VITE_ANCHOR_HOME_DOMAIN=
VITE_MAX_MEMBERS=12
