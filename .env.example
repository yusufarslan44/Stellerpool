# Stellar Testnet
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Filled in after deployment
ROTATING_POOL_CONTRACT_ID=
TOKEN_CONTRACT_ID=

# Anchor home domain (stellar.toml). If empty, the interface uses the SDF test anchor
# (testanchor.stellar.org): a real SEP-1/10/24 flow, a test asset, NOT TRY.
ANCHOR_HOME_DOMAIN=

# Frontend (Vite)
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_ROTATING_POOL_CONTRACT_ID=
# Anchor (testanchor.stellar.org if empty) and the largest group the interface allows.
# The published contract supports up to 30 members.
VITE_ANCHOR_HOME_DOMAIN=
VITE_MAX_MEMBERS=30
